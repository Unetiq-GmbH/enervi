# Copy this file to backend/.env and frontend/.env, then replace the placeholders.
# Do not commit files that contain real values. .env is gitignored.

# --- Backend (backend/.env) ---
NODE_ENV=development
PORT=5001

# Preferred database setting: a full MongoDB URI with no credentials in source.
MONGODB_URI=mongodb://localhost:27017/enervi
# Set to true for servers that require TLS, such as Azure Cosmos DB for MongoDB.
MONGODB_TLS=false

# Used only when MONGODB_URI is empty. Leave the secrets blank.
DEV_COSMOSDB_USER=
DEV_COSMOSDB_PASSWORD=
DEV_COSMOSDB_DBNAME=enervi
DEV_COSMOSDB_HOST=localhost
DEV_COSMOSDB_PORT=27017
PROD_COSMOSDB_USER=
PROD_COSMOSDB_PASSWORD=
PROD_COSMOSDB_DBNAME=enervi
PROD_COSMOSDB_HOST=
PROD_COSMOSDB_PORT=27017

# Auth0 tenant domain without a scheme, and the API audience.
AUTH0_DOMAIN=your-tenant.example.com
AUTH0_AUDIENCE=https://your-api.example.com

# Shared secret between the API and the image service. Use a long random string.
EXPRESS_FLASK_KEY=replace-with-a-long-random-string

# Base URL of the image service.
DEV_GPU_URL=http://localhost:8080
PROD_GPU_URL=http://localhost:8080

# Blob storage. Paste the connection string from your storage account.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_PIN_IMAGES_CONTAINER=files
AZURE_STORAGE_SCENARIO_IMAGES_CONTAINER=scenario-images
AZURE_STORAGE_SHORT_IMAGES_CONTAINER=short-images

# --- Frontend (frontend/.env) ---
VITE_REACT_APP_URL=http://localhost:5001
VITE_REACT_APP_GPU_URL=http://localhost:8080
VITE_REACT_APP_AUTH0_ISSUER_BASE_URL=your-tenant.example.com
VITE_REACT_APP_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_REACT_APP_AUTH0_AUDIENCE=https://your-api.example.com

# --- Image services (ai/ and ai-startup/) ---
EXPRESS_SERVER_URL=http://localhost:5001
STARTUP_SERVER_URL=http://localhost:8081/enervi
RUNTIME_ENV=local
MODEL_CACHE_PATH=
HUGGINGFACE_HUB_CACHE=
FLASK_DEBUG=0

# Optional provider credentials. Leave empty to disable that provider.
SEGMIND_API_KEY=
OPENAI_KEY=
GEMINI_API_KEY=
IMAGINEPRO_API_KEY=
